#!/usr/bin/env bash
set -euo pipefail
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# The development shim must never hide the installed application.
# Deliberate source-only operations remain available explicitly.
case "${1:-}" in
  update-source)
    shift
    exec bash "$HERE/tools/update.sh" "$@"
    ;;
  run-source)
    shift
    exec python3 "$HERE/src/linux_bridge_console/dashboard.py" "$@"
    ;;
  *)
    if [[ -x /usr/bin/lbc ]]; then
      exec /usr/bin/lbc "$@"
    fi
    if [[ "${1:-}" == update ]]; then
      shift
      exec bash "$HERE/tools/update.sh" "$@"
    fi
    exec python3 "$HERE/src/linux_bridge_console/dashboard.py" "$@"
    ;;
esac
