#!/usr/bin/env bash
set -euo pipefail
APP="/usr/lib/linux-bridge-console"
STATE="$HOME/.local/share/linux-bridge-console/worker-state.json"
SERVICE_DIR="$HOME/.config/systemd/user"
case "${1:-}" in
  status)
    if [[ -f "$STATE" ]]; then cat "$STATE"; else echo "No worker status yet. Run: lbc install-service"; fi
    ;;
  update)
    shift
    exec bash "$APP/update-package.sh" "$@"
    ;;
  auto-update)
    case "${2:-status}" in
      enable) exec sudo /usr/lib/linux-bridge-console/enable-auto-update.sh ;;
      status) exec systemctl status lbc-auto-update.timer --no-pager ;;
      *) echo "Usage: lbc auto-update [enable|status]" >&2; exit 2 ;;
    esac
    ;;
  install-service)
    mkdir -p "$SERVICE_DIR"
    install -m 0644 "/usr/lib/systemd/user/linux-bridge-console.service" \
      "$SERVICE_DIR/linux-bridge-console.service"
    systemctl --user daemon-reload
    systemctl --user enable --now linux-bridge-console.service
    echo "Worker enabled for this user (auto-run disabled)."
    echo "GitHub authentication: run gh auth login for this same user."
    echo "For unattended operation after logout: sudo loginctl enable-linger $(id -un)"
    ;;
  *)
    exec python3 "$APP/dashboard.py" "$@"
    ;;
esac
