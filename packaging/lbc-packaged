#!/usr/bin/env bash
set -euo pipefail
APP="/usr/lib/linux-bridge-console"
USER_APP="$HOME/.local/share/linux-bridge-console/current/usr/lib/linux-bridge-console"
case "${1:-}" in
  update)
    shift
    exec bash "$APP/update-user.sh" "$@"
    ;;
  update-system)
    shift
    exec bash "$APP/update-package.sh" "$@"
    ;;
  status)
    exec python3 - "$HOME/.local/share/linux-bridge-console/console-settings.json" <<'PY'
import json, sys
from pathlib import Path
p=Path(sys.argv[1])
print(json.dumps(json.loads(p.read_text()) if p.exists() else {"autoRun": False, "autoSend": True},indent=2))
PY
    ;;
  *)
    if [[ -f "$USER_APP/dashboard.py" ]]; then
      exec python3 "$USER_APP/dashboard.py" "$@"
    fi
    exec python3 "$APP/dashboard.py" "$@"
    ;;
esac
